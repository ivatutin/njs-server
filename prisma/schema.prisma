generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["user", "public"]
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String?   @unique
  phone           String?   @unique
  /**
   * Стабильный login-handle (ADR-0017 ред.2, путь B): НЕ PII, неизменяем, уникален.
   * Он же — `username` пользователя в Keycloak, поэтому используется как `login_hint` в CIBA
   * и как логин в password-grant. Nullable: строки, созданные до политики, и пользователи,
   * заведённые вне наших sign-up (тогда резолвер падает на email).
   */
  handle          String?   @unique
  emailVerifiedAt DateTime? @map("email_verified_at")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  keycloakId      String    @unique @map("keycloak_id")
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  roles           String[]  @default([])
  metadata        Json?
  status          String    @default("pending_verification")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("users")
  @@schema("user")
}
