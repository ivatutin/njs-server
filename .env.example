# App
NODE_ENV=development
APP_PORT=3001
APP_PATH_PREFIX=api/v1
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Хост-порт Valkey в docker compose (если 6379 занят другим проектом)
# REDIS_HOST_PORT=6379

# Keycloak (for docker-compose)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Опционально: базовый образ Keycloak для сборки (по умолчанию официальный quay.io;
# переопредели, если CDN quay.io недоступен из твоей сети)
# KEYCLOAK_IMAGE=docker.io/keycloak/keycloak:26.8.0

# Keycloak (for app)
KEYCLOAK_URL=http://localhost:8088
KEYCLOAK_REALM=app
KEYCLOAK_CLIENT_ID=app-backend
KEYCLOAK_CLIENT_SECRET=change-me
# Ожидаемый issuer токенов. Оставь закомментированным, если Keycloak доступен
# приложению по тому же адресу, что и браузеру (по умолчанию: KEYCLOAK_URL + /realms/REALM).
# Пример для docker-контейнера: KEYCLOAK_URL=http://keycloak:8080, а issuer — публичный
# KEYCLOAK_ISSUER=http://localhost:8088/realms/app (см. ADR-0013).
# KEYCLOAK_ISSUER=http://localhost:8088/realms/app

# Throttler
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Подтверждение телефона обратным звонком (SMS.ru callcheck, ADR-0014)
# api_id из личного кабинета SMS.ru. Пусто + включённый флаг → 503 без звонков.
SMSRU_API_ID=
# true — боевой канал; false (по умолчанию) — dev-заглушка, которая «подтверждает
# звонок» сама через SMSRU_DEV_CONFIRM_AFTER_SECONDS. В production заглушка запрещена.
SMSRU_CALLCHECK_ENABLED=false
# База API провайдера: менять не нужно, переопределяется в тестах/локальных прогонах
SMSRU_API_BASE_URL=https://sms.ru
# Dev-заглушка: через сколько секунд считать «звонок» состоявшимся
SMSRU_DEV_CONFIRM_AFTER_SECONDS=15

# Адрес нашего «канала аутентификации» CIBA, который задаётся Keycloak (ADR-0015).
# По умолчанию compose выводит его из внутреннего имени app-backend, APP_PORT и
# APP_PATH_PREFIX; переопределять нужно только при нестандартной топологии сети.
# CIBA_CHANNEL_URL=http://app-backend:3001/api/v1/internal/ciba/channel
